# Copy this file to .env and fill in the key. .env is gitignored.
#
#   cp .env.example .env
#
# The router talks to the Anthropic API via the official SDK.
ANTHROPIC_API_KEY=

# MOCK=1 runs the whole system against a deterministic offline provider:
# no network, no spend, reproducible numbers. Leave it on while developing.
# Unset it (or MOCK=0) once a real key is in place to go live.
MOCK=1

# Reliability: let the API route around a refusal server-side instead of
# failing the request. Disabled automatically if the beta is unavailable.
ENABLE_SERVER_FALLBACK=1

# LLM-as-judge grading for open-ended eval items. Costs money (cheap tier).
# Deterministic checkable items are graded locally and are unaffected.
ENABLE_LLM_JUDGE=0
